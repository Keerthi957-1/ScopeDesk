# Copy this file to ".env" next to server.js and fill in your values. Never commit the real .env.
#
# EMAIL, THE EASY WAY: skip this file. Open ScopeDesk on the computer the server runs on, press "Create an account", and the app shows a
# one-time "Connect email" screen (Gmail address + App Password). It tests the login, then saves it in mail-settings.json (owner-only, git-ignored).
# On a hosted server (Railway ...) set the variables below in the host's settings instead: the in-app screen is deliberately disabled there.

# ---- Email (password-reset codes) ----
# Gmail (needs 2-Step Verification + an App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Mailtrap sandbox instead (emails land in your Mailtrap inbox, nothing is delivered for real):
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-mailtrap-username
# SMTP_PASS=your-mailtrap-password

# Optional
# MAIL_FROM=ScopeDesk <your.address@gmail.com>
# SMTP_SECURE=false

# ---- Email through Brevo (use this on Railway and other hosts that block SMTP) ----
# Railway's free/Hobby plans block Gmail's mail ports, so SMTP times out there. Brevo sends over HTTPS instead (free: 300 emails/day).
# 1) brevo.com > create account  2) Senders: add and verify your sender address  3) SMTP & API > API Keys > create a key
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
# BREVO_SENDER_EMAIL=your.verified.address@gmail.com
# MAIL_FROM=ScopeDesk <your.verified.address@gmail.com>

# ---- Sign-up email verification ----
# New accounts must enter a 6-digit emailed code before they can sign in. Needs the SMTP settings above.
# Local development without SMTP only (NEVER on a real server):
# EMAIL_VERIFICATION=off
# Extra blocked throw-away domains (comma separated):
# DISPOSABLE_EMAIL_DOMAINS=mailinator.com,example-temp.test

# ---- Cross-network screen sharing (WebRTC) ----
# STUN is built in (Google + Cloudflare). For reliable sharing between different ISPs / mobile networks / strict firewalls
# you also need a TURN relay (coturn on any small VPS, or a hosted TURN service). Recommended: coturn with "use-auth-secret".
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# One address is enough: TURN_URL=turn:turn.example.com:3478  (a bare turn: address is tried over UDP and TCP automatically)
# TURN_SECRET=the-same-value-as-static-auth-secret-in-turnserver.conf
# ...or a fixed TURN account instead of TURN_SECRET:
# TURN_USERNAME=user
# TURN_CREDENTIAL=password        (TURN_PASSWORD works too)
# With TURN_SECRET, TURN_USERNAME is only a label inside the short-lived username ScopeDesk mints per session.
# ICE_TRANSPORT_POLICY=all
