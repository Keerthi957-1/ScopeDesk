# ScopeDesk runs on Railway. On Railway you do NOT use a .env file: put these in  Railway > your service > Variables.
# This file only lists what exists. Copy it to ".env" only if you ever run the server on your own computer for development.
#
# PORT and the public address are provided by Railway automatically (PORT, RAILWAY_PUBLIC_DOMAIN). Do not set them there.

# ---- REQUIRED on Railway ----------------------------------------------------------------------------------------------
# Signs everybody in. A long random string (at least 48 characters). If it is missing, a new one is made on every deploy and
# every user is signed out after each update.
JWT_SECRET=
NODE_ENV=production

# Add a Volume to the service (Railway > service > Volumes, mount path /data). The database is then stored on it automatically.
# Without a volume ALL accounts and tasks are wiped on every deploy. Only set DB_PATH if you want a different file:
# DB_PATH=/data/scopedesk.db

# Stops the Electron desktop app (a dev dependency) from downloading its ~100 MB binary during the Railway build.
ELECTRON_SKIP_BINARY_DOWNLOAD=1

# ---- Optional ---------------------------------------------------------------------------------------------------------
# Public address used in password-reset emails. Leave empty on Railway: it is taken from the service's public domain.
# APP_URL=https://your-app.up.railway.app

# Other websites allowed to call the API (comma separated). Not needed when people open the Railway address itself.
# CORS_ORIGIN=https://your-frontend.example.com

# ---- Password-reset emails (Gmail example) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
# A Gmail "App Password" (16 letters), NOT your normal Gmail password
SMTP_PASS=
MAIL_FROM=ScopeDesk <your.address@gmail.com>

# ---- Security behaviour ----
# Keep the WebRTC stream running after a security violation until the Client presses "Terminate Connection" (default: cut at once)
# AUTO_CUT_STREAM=false
# A violation locks the vendor out for good. Set true to let the Client resume the session instead.
# ALLOW_RESUME_AFTER_VIOLATION=false

# ---- WebRTC relay (strongly recommended, see README) ----
# Railway cannot host a TURN server (it has no UDP). Use a hosted TURN service or your own coturn (use-auth-secret) elsewhere.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=your-coturn-static-auth-secret
# TURN_FORCE_RELAY=true

# Proxy hops to trust for the client's real IP (login rate limits). Default 1 on Railway. 0 = off.
# TRUST_PROXY=1
