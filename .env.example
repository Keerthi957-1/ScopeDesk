# Copy this file to a new file named ".env" (same folder as server.js) and fill it in. Never share or commit .env.
PORT=3000

# Link used inside reset emails. Keep as-is when you open the app on this computer.
APP_URL=http://localhost:3000

# ---- Real password-reset emails (Gmail example) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
# A Gmail "App Password" (16 letters), NOT your normal Gmail password
SMTP_PASS=
# Optional sender name shown in the inbox
MAIL_FROM=ScopeDesk <your.address@gmail.com>

# Optional: fixed secret for logins. If empty, a random one is created once in .jwt_secret
# JWT_SECRET=
# NODE_ENV=production

# Keep the WebRTC stream running after a security violation until the Client presses "Terminate Session Now"
# (default: the stream is cut instantly)
# AUTO_CUT_STREAM=false

# ---- WebRTC relay (recommended for production) ----
# With a coturn server (use-auth-secret) the stream is relayed and its credentials expire when the task window ends.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=your-coturn-static-auth-secret
# TURN_FORCE_RELAY=true

# A violation locks the vendor out for good (the Client can only terminate). Set true to let the Client resume the session instead.
# ALLOW_RESUME_AFTER_VIOLATION=false
